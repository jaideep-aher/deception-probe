{
  "manifest_version": 3,
  "name": "DeceptionProbe: LLM Mechanistic Polygraph HUD",
  "version": "1.0.0",
  "description": "Real-time mechanistic honesty probe and truthfulness steering HUD directly inside ChatGPT and Claude.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DeceptionProbe Controls"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
